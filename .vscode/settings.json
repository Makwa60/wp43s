{
    "mesonbuild.setupOptions": [
        "-Db_coverage=true"
    ],
    "mesonbuild.buildFolder": "build.sim",
    "mesonbuild.configureOptions": [
        "--buildtype=debug"
    ],
    "mesonbuild.configureOnOpen": true,
    "lldb.launch.initCommands": [
        "command source -s true tools/lldb/helpers"
    ],
    "testMate.cpp.test.advancedExecutables": [
        {
            "pattern": "build.sim/src/tests/tests",
            "runTask": {
                "before": ["Meson: Build src/tests/tests"]
            }
        }
    ]
}